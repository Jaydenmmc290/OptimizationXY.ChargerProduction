<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false"
      throwConfigExceptions="true"
      internalLogLevel="Info"
      internalLogFile="${specialfolder:folder=CommonApplicationData}\OptimizationXY\Charger\Logs\NLog-Internal.log">

  <!--
    Production:
      install-production.ps1 sets OPTIMIZATION_XY_DATA_DIR,
      normally to D:\OptimizationXYData.

    Development fallback:
      If the environment variable is not set, logs go beneath
      the executable folder in Logs.
  -->
  <variable name="dataRoot"
            value="${environment:variable=OPTIMIZATION_XY_DATA_DIR:default=${basedir}}" />

  <variable name="logDirectory"
            value="${var:dataRoot}\Logs" />

  <variable name="layout"
            value="${longdate}|${level:uppercase=true}|pid=${processid}|thread=${threadid}|${logger}|${message}${onexception:inner=|${exception:format=tostring}}" />

  <targets async="true">

    <target xsi:type="File"
            name="applicationFile"
            fileName="${var:logDirectory}\Application.log"
            archiveFileName="${var:logDirectory}\Archive\Application.log"
            archiveSuffixFormat=".{1:yyyyMMdd-HHmmss}.{0:00}"
            archiveAboveSize="10485760"
            maxArchiveFiles="10"
            createDirs="true"
            keepFileOpen="false"
            encoding="utf-8"
            layout="${var:layout}" />

    <target xsi:type="Debugger"
            name="debugger"
            layout="${var:layout}" />

  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="applicationFile" />
    <logger name="*" minlevel="Debug" writeTo="debugger" />
  </rules>

</nlog>
