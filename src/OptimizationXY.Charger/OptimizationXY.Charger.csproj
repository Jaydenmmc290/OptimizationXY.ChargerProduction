<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>OptimizationXY.Charger</RootNamespace>
    <AssemblyName>OptimizationXY.Charger</AssemblyName>
    <VersionPrefix>5.0.1</VersionPrefix>
    <AssemblyVersion>5.0.1.0</AssemblyVersion>
    <FileVersion>5.0.1.0</FileVersion>
    <InformationalVersion>5.0.1-production-hardened</InformationalVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>

    <UseSapera Condition="'$(UseSapera)' == ''">true</UseSapera>
    <RequireSapera Condition="'$(RequireSapera)' == ''">false</RequireSapera>
    
    <UseSapera8 Condition="'$(UseSapera8)' == ''">false</UseSapera8>

    <Sapera8AssemblyPath Condition="'$(UseSapera8)' == 'true'">$(MSBuildThisFileDirectory)..\..\lib\Sapera8\DALSA.SaperaLT.SapClassBasic.dll</Sapera8AssemblyPath>
    
    <SaperaSdkDir Condition="'$(UseSapera)' == 'true' and '$(SaperaSdkDir)' == ''">$(SAPERA_SDK_DIR)</SaperaSdkDir>
    <SaperaSdkDir Condition="'$(UseSapera)' == 'true' and '$(SaperaSdkDir)' == ''">$(ProgramFiles)\Teledyne DALSA\Sapera\Components\NET\Bin</SaperaSdkDir>
    <SaperaAssemblyPath Condition="'$(UseSapera)' == 'true'">$(SaperaSdkDir)\DALSA.SaperaLT.SapClassBasic.Core.dll</SaperaAssemblyPath>
    <XyRestrictedLibDir>$(MSBuildThisFileDirectory)..\..\lib\XYRestricted</XyRestrictedLibDir>
    <XyRestrictedAssemblyPath>$(XyRestrictedLibDir)\XYRestricted.dll</XyRestrictedAssemblyPath>
    <AsCommAssemblyPath>$(XyRestrictedLibDir)\AutomatedSolutions.ASCommStd.dll</AsCommAssemblyPath>
    <HasSaperaSdk Condition="'$(UseSapera)' == 'true' and Exists('$(SaperaAssemblyPath)')">true</HasSaperaSdk>
    <HasSaperaSdk Condition="'$(HasSaperaSdk)' == ''">false</HasSaperaSdk>
    <DefineConstants Condition="'$(HasSaperaSdk)' == 'true'">$(DefineConstants);SAPERA</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseSapera8)' == 'true'">
    <DefineConstants>$(DefineConstants);SAPERA</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

 

  <ItemGroup>
    <PackageReference Include="Emgu.CV" Version="4.13.0.5924" />
    <PackageReference Include="Emgu.CV.Bitmap" Version="4.13.0.5924" />
    <PackageReference Include="Emgu.CV.runtime.windows" Version="4.13.0.5924" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="NLog" Version="6.1.3" />
  </ItemGroup>



  <ItemGroup>
    <Reference Include="XYRestricted">
      <HintPath>$(XyRestrictedAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AutomatedSolutions.ASCommStd">
      <HintPath>$(AsCommAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>



  <!-- Sapera 9 -->
  <ItemGroup Condition="'$(UseSapera8)' != 'true' and '$(HasSaperaSdk)' == 'true'">
    <Reference Include="DALSA.SaperaLT.SapClassBasic.Core">
      <HintPath>$(SaperaAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Sapera 8 -->
  <ItemGroup Condition="'$(UseSapera8)' == 'true'">
    <Reference Include="$(Sapera8AssemblyPath)">
      <HintPath>$(Sapera8AssemblyPath)</HintPath>
      <Private>true</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  
  <ItemGroup>
    <None Remove="licenses.licx" />
    <None Remove="NLog.config" />

    <Content Include="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  
  <ItemGroup>
    <EmbeddedResource Include="licenses.licx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  

  <Target Name="ValidateProductionDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(UseSapera8)' == 'true' and !Exists('$(Sapera8AssemblyPath)')" Text="Sapera 8 assembly was not found at $(Sapera8AssemblyPath)." />
    <Error Condition="!Exists('$(XyRestrictedAssemblyPath)')" Text="XYRestricted.dll was not found at $(XyRestrictedAssemblyPath)." />
    <Error Condition="!Exists('$(AsCommAssemblyPath)')" Text="AutomatedSolutions.ASCommStd.dll was not found at $(AsCommAssemblyPath)." />
  </Target>

  <Target Name="ReportSaperaBuildMode" BeforeTargets="PrepareForBuild">
    <Message Condition="'$(UseSapera8)' == 'true'" Importance="high" Text="Sapera 8 test assembly path: $(Sapera8AssemblyPath)" />
    <Error Condition="'$(RequireSapera)' == 'true' and '$(HasSaperaSdk)' != 'true'" Text="A hardware build was requested, but the Sapera SDK assembly was not found. Set SAPERA_SDK_DIR or SaperaSdkDir, or explicitly build with UseSapera=false." />
    <Message Condition="'$(HasSaperaSdk)' == 'true'" Importance="high" Text="Building with Sapera camera support from $(SaperaAssemblyPath)." />
    <Message Condition="'$(UseSapera)' != 'true'" Importance="high" Text="Sapera support was explicitly disabled. Building with the non-hardware camera stub." />
    <Warning Condition="'$(UseSapera)' == 'true' and '$(HasSaperaSdk)' != 'true'" Text="Sapera SDK was not found. Building with the non-hardware camera stub. Set SAPERA_SDK_DIR or SaperaSdkDir for production hardware builds." />
  </Target>

</Project>
